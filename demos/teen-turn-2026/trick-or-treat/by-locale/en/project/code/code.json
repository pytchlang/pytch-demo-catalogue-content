r Treat!\", 1)\n    else:\n      pass\nelif Stage.current_backdrop == 2:\n    if self.touching(house1T):\n        self.broadcast(\"knocked_1T\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house2T):\n        self.broadcast(\"knocked_2T\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house3T):\n        self.broadcast(\"knocked_3T\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    else:\n        pass\nelif Stage.current_backdrop == 3:\n    if self.touching(house1B):\n        self.broadcast(\"knocked_1B\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house2B):\n        self.broadcast(\"knocked_2B\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house3B):\n        self.broadcast(\"knocked_3B\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house4B):\n        self.broadcast(\"knocked_4B\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    else:\n        pass\nelif Stage.current_backdrop == 4:\n    if self.touching(house1L):\n        self.broadcast(\"knocked_1L\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house2L):\n        self.broadcast(\"knocked_2L\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house3L):\n        self.broadcast(\"knocked_3L\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house4L):\n        self.broadcast(\"knocked_4L\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    else:\n        pass\nelif Stage.current_backdrop == 5:\n    if self.touching(house1R):\n        self.broadcast(\"knocked_1R\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house2R):\n        self.broadcast(\"knocked_2R\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(house3R):\n        self.broadcast(\"knocked_3R\")\n        self.say_for_seconds(\"Trick or Treat!\", 1)\n    elif self.touching(home):\n        self.broadcast(\"open_door_home\")\n    else:\n        pass\nelse:\n    pass"},{"id":"c986cacd-4807-4008-80a1-f7bbb9badcb3","event":{"kind":"key-pressed","keyName":"w"},"pythonCode":"self.change_y(10)\nself.switch_costume(\"forward_skin.png\")\nif Stage.current_backdrop == 1 and self.y_position >= 170:\n    self.change_y(-10)\n    self.broadcast(\"top_hit\")\n    self.go_to_xy(0, -178)\nif Stage.current_backdrop == 3 and self.y_position >= 165:\n    self.change_y(-10)\n    self.broadcast(\"find_spawn\")\n    self.broadcast(\"back_to_centre\") \n    self.broadcast(\"out_of_bottom\")"},{"id":"76e1414f-9aa8-420d-a537-295aa298ed9a","event":{"kind":"key-pressed","keyName":"a"},"pythonCode":"self.change_x(-10)\nself.switch_costume(\"left_skin.png\")\nif Stage.current_backdrop == 1 and self.x_position <= -230:\n    self.change_y(10)\n    self.broadcast(\"far_left_hit\")\n    self.broadcast(\"back_to_left\")\n    self.go_to_xy(228, 43)\nif Stage.current_backdrop == 5 and self.x_position <= -235:\n    self.change_y(10)\n    self.broadcast(\"find_spawn\")\n    self.broadcast(\"back_to_centre\")    \n    self.broadcast(\"out_of_right\")"},{"id":"8f1effdb-e71e-4601-9443-ea9683be5f9a","event":{"kind":"key-pressed","keyName":"s"},"pythonCode":"self.change_y(-10)\nself.switch_costume(\"backwards_skin.png\")\nif Stage.current_backdrop == 1 and self.y_position <= -170:\n    self.change_y(10)\n    self.broadcast(\"bottom_hit\")\n    self.broadcast(\"back_to_bottom\")\n    self.go_to_xy(0, 171)\nif Stage.current_backdrop == 2 and self.y_position <= -185:\n    self.change_y(10)\n    self.broadcast(\"find_spawn\")\n    self.broadcast(\"back_to_centre\") \n    self.broadcast(\"out_of_top\")"},{"id":"6ba2fd8e-fb85-45d2-b13f-ab3495bd7027","event":{"kind":"key-pressed","keyName":"d"},"pythonCode":"self.change_x(10)\nself.switch_costume(\"right_skin.png\")\nif Stage.current_backdrop == 1 and self.x_position >= 230:\